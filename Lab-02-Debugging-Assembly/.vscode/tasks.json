{
    "version": "2.0.0",
    "tasks": [
        {
          "label": "Build",
          "type": "shell",
          "command": "make GCC_PATH=${userHome}/tools/arm-gnu-toolchain-13.2.Rel1-x86_64-arm-none-eabi/bin",
          "problemMatcher": {
            "base": "$gcc",
            "fileLocation": ["relative", "${workspaceFolder}"]
          },
          "group": {
              "kind": "build",
              "isDefault": true
          }
        }
    ]
}