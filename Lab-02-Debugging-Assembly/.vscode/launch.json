{
    "version": "0.2.0",
    "configurations": [
        {
            "name" : "QEMU Debug",
            "cwd" : "${workspaceFolder}",
            "executable" : "${workspaceFolder}/STM32VLDiscovery.elf",
            "request": "launch",
            "type" : "cortex-debug",
            "servertype" : "qemu",
            "machine": "stm32vldiscovery",
            "runToEntryPoint": "main",
            "preLaunchTask": "Build",
            "qemuArgs": [
                "-serial", "stdio"
            ],
            "armToolchainPath" : "${userHome}/tools/arm-gnu-toolchain-13.2.Rel1-x86_64-arm-none-eabi/bin"
        }
    ]
}